{
  "name": "incident-management",
  "version": "1.0.0",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@cap-js/hana": "2.8.0",
    "@sap-ux/eslint-plugin-fiori-tools": "10.0.5",
    "@sap/cds": "^9.9.1",
    "@sap/ux-ui5-tooling": "1.24.0",
    "@sap/xssec": "X",
    "ejs": "5.0.2",
    "eslint": "10.3.0"
  },
  "devDependencies": {
    "@cap-js/cds-test": "1.0.1",
    "@cap-js/sqlite": "2",
    "@sap/cds-dk": "9",
    "@ui5/cli": "3.11.7",
    "cds-plugin-ui5": "^0.17.1"
  },
  "scripts": {
    "test": "npx jest tests/test.js",
    "port" : "5005",
    "start": "cds-serve",
